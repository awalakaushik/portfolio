---
import BaseLayout from '../layouts/BaseLayout.astro';
import FadeIn from '../components/FadeIn.tsx';
import ProjectCard from '../components/ProjectCard.tsx';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection } from 'astro:content';

// Fetch content
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const techStack = await getCollection('tech-stack');
const categories = [...new Set(techStack.map((t) => t.data.category))];
---

<BaseLayout>
  <!-- ===== HERO SECTION ===== -->
  <section class="relative min-h-screen flex items-center section-padding overflow-hidden">
    <!-- Background glow effects -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 -left-1/4 w-96 h-96 bg-primary-500/10 rounded-full blur-3xl" />
      <div class="absolute bottom-1/4 -right-1/4 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl" />
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary-500/5 rounded-full blur-3xl" />
    </div>

    <div class="relative max-w-6xl mx-auto w-full">
      <FadeIn client:visible>
        <div class="flex flex-col gap-6">
          <!-- Tag -->
          <div class="inline-flex items-center gap-2 w-fit rounded-full border border-surface-200 dark:border-surface-800 bg-white/50 dark:bg-surface-900/50 backdrop-blur-sm px-4 py-1.5">
            <span class="w-2 h-2 rounded-full bg-accent-500 animate-pulse" />
            <span class="text-xs font-medium text-surface-600 dark:text-surface-400">Available for opportunities</span>
          </div>

          <!-- Heading -->
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.1]">
            <span class="text-surface-900 dark:text-white">Hi, I'm</span>
            <br />
            <span class="text-gradient">Kaushik Reddy</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-lg md:text-xl text-surface-500 dark:text-surface-400 max-w-xl leading-relaxed">
            Software Engineer based in Houston, TX. Full-stack developer focused on responsive, accessible design — passionate about efficiency, optimization, and building with purpose.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 mt-2">
            <a
              href="/projects"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-medium text-sm transition-all hover:shadow-lg hover:shadow-primary-500/25 active:scale-[0.98]"
            >
              View Projects
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-surface-200 dark:border-surface-700 text-surface-700 dark:text-surface-300 hover:bg-surface-50 dark:hover:bg-surface-800/50 font-medium text-sm transition-all active:scale-[0.98]"
            >
              Get in Touch
            </a>
          </div>
        </div>
      </FadeIn>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
      <div class="w-5 h-8 rounded-full border-2 border-surface-300 dark:border-surface-700 flex items-start justify-center p-1">
        <div class="w-1 h-2 rounded-full bg-surface-400 dark:bg-surface-600 animate-bounce" />
      </div>
    </div>
  </section>

  <!-- ===== ABOUT SNIPPET ===== -->
  <section class="section-padding bg-surface-50/50 dark:bg-surface-900/20">
    <div class="max-w-6xl mx-auto">
      <FadeIn client:visible>
        <SectionHeading title="About Me" subtitle="A quick snapshot of who I am and what I do." />
      </FadeIn>
      <FadeIn client:visible delay={0.1}>
        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div class="space-y-4">
            <p class="text-surface-600 dark:text-surface-400 leading-relaxed">
              I'm a full-stack web developer focused on responsive and accessible design. Passionate about efficiency, optimization, and working in a culture of "Purpose" to change the world.
            </p>
            <p class="text-surface-600 dark:text-surface-400 leading-relaxed">
              When I'm not coding, you'll find me exploring quantum computing, playing table tennis, writing poetry,
              or experimenting in the kitchen. Currently learning advanced React patterns, ML.NET, and Quantum Computing Fundamentals.
            </p>
            <a
              href="/about"
              class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-medium text-sm hover:gap-3 transition-all"
            >
              Read more about me
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>

          <!-- Quick stats -->
          <div class="grid grid-cols-3 gap-4">
            <div class="glass-card p-5 text-center">
              <p class="text-3xl font-bold text-gradient">8+</p>
              <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">Years Experience</p>
            </div>
            <div class="glass-card p-5 text-center">
              <p class="text-3xl font-bold text-gradient">4+</p>
              <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">Companies</p>
            </div>
            <div class="glass-card p-5 text-center">
              <p class="text-3xl font-bold text-gradient">12+</p>
              <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">Technologies</p>
            </div>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- ===== FEATURED PROJECTS ===== -->
  <section class="section-padding">
    <div class="max-w-6xl mx-auto">
      <FadeIn client:visible>
        <SectionHeading
          title="Featured Projects"
          subtitle="A selection of my recent work that I'm most proud of."
        />
      </FadeIn>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map((project, i) => (
          <FadeIn client:visible delay={i * 0.1}>
            <ProjectCard
              client:visible
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              image={project.data.image}
              liveUrl={project.data.liveUrl}
              githubUrl={project.data.githubUrl}
              slug={project.id}
              achievements={project.data.achievements}
              company={project.data.company}
            />
          </FadeIn>
        ))}
      </div>

      <FadeIn client:visible delay={0.3}>
        <div class="text-center mt-12">
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-surface-200 dark:border-surface-700 text-surface-700 dark:text-surface-300 hover:bg-surface-50 dark:hover:bg-surface-800/50 font-medium text-sm transition-all"
          >
            View All Projects
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- ===== TECH STACK ===== -->
  <section class="section-padding bg-surface-50/50 dark:bg-surface-900/20">
    <div class="max-w-6xl mx-auto">
      <FadeIn client:visible>
        <SectionHeading
          title="Tech Stack"
          subtitle="The tools and technologies I work with every day."
          align="center"
        />
      </FadeIn>

      <div class="space-y-8">
        {categories.map((category, ci) => (
          <FadeIn client:visible delay={ci * 0.1}>
            <div>
              <h3 class="text-xs font-semibold text-surface-400 dark:text-surface-500 uppercase tracking-widest mb-5 text-center">
                {category}
              </h3>
              <div class="flex flex-wrap justify-center gap-4">
                {techStack
                  .filter((t) => t.data.category === category)
                  .map((tech) => (
                    <div class="glass-card px-5 py-3.5 flex items-center gap-3 hover:border-primary-500/30 dark:hover:border-primary-500/30 hover:-translate-y-0.5 transition-all duration-200 cursor-default">
                      <img
                        src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${tech.data.icon}/${tech.data.icon}-original.svg`}
                        alt={tech.data.name}
                        class="w-5 h-5"
                        loading="lazy"
                        onerror={`this.onerror=function(){this.onerror=null;this.src='https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${tech.data.icon}/${tech.data.icon}-original-wordmark.svg'};this.src='https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${tech.data.icon}/${tech.data.icon}-plain-wordmark.svg'`}
                      />
                      <span class="text-sm font-medium text-surface-700 dark:text-surface-300">
                        {tech.data.name}
                      </span>
                    </div>
                  ))}
              </div>
            </div>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA SECTION ===== -->
  <section class="section-padding">
    <div class="max-w-3xl mx-auto text-center">
      <FadeIn client:visible>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-surface-900 dark:text-white">
          Let's build something <span class="text-gradient">amazing</span> together.
        </h2>
        <p class="mt-4 text-lg text-surface-500 dark:text-surface-400">
          Whether you're a recruiter, a fellow developer, or someone with an exciting idea — I'd love to hear from you.
        </p>
        <div class="mt-8">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-medium transition-all hover:shadow-lg hover:shadow-primary-500/25 active:scale-[0.98]"
          >
            Get in Touch
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </FadeIn>
    </div>
  </section>
</BaseLayout>
